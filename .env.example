# -----------------------------------------------------------------------------
# Environment Variables for TDA GIS Projects
#
# INSTRUCTIONS:
# 1. Create a copy of this file and rename it to `.env`.
# 2. Fill in the required credentials and settings below.
# 3. DO NOT commit the .env file to Git. It is already in the .gitignore.
# -----------------------------------------------------------------------------

# ArcGIS Online Credentials
# Used by the `arcgis` library to authenticate with your organization's portal.
PORTAL_URL="https://www.arcgis.com"
USERNAME="your_agol_username"
PASSWORD="your_agol_password"

# Example for another service's API key (uncomment and use as needed)
# ANOTHER_API_KEY="your_api_key_here"